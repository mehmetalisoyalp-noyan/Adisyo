// Restoran Yönetim Sistemi — veri modeli
// Çok kiracılı (multi-tenant): her kayıt bir Organization'a (işletme grubu) bağlıdır.
// Böylece ileride başka işletmelere abonelik satılabilir; veri ayrımı organizationId ile sağlanır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Tablo kurulumu (migration) için havuzsuz doğrudan bağlantı — Neon'da "pooled" olmayan adres
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- Kiracı & kullanıcılar

/// Grup / abonelik (kiracı). Bir veya daha fazla şirketi (tüzel kişi) kapsar.
/// taxNumber/taxOffice alanları eskiden kalmadır; vergi bilgileri artık Company'de tutulur.
model Organization {
  id        String   @id @default(cuid())
  name      String
  taxNumber String?
  taxOffice String?
  plan      Plan     @default(STANDARD)
  createdAt DateTime @default(now())

  companies      Company[]
  branches       Branch[]
  users          User[]
  categories     Category[]
  products       Product[]
  stockItems     StockItem[]
  accounts       Account[]
  ledgerEntries  LedgerEntry[]
  itemMappings   SupplierItemMapping[]
  stockCounts    StockCount[]
  salesImports   SalesImport[]
  productAliases ProductAlias[]
  adisyoAccount  AdisyoAccount?
  adisyoOrders   AdisyoOrder[]
  purchases      PurchaseInvoice[]
  orders         Order[]
  movements      StockMovement[]
  eDocuments     EDocument[]
}

enum Plan {
  STANDARD
  PRO
}

/// Şirket (tüzel kişi): kendi ünvanı ve vergi numarası olan işletme.
/// Alışlar, cari bakiyeler ve e-belgeler şirket bazında ayrılır.
model Company {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Ticari ünvan (faturalarda görünen)
  name           String
  taxNumber      String?
  taxOffice      String?
  address        String?
  createdAt      DateTime     @default(now())

  branches Branch[]
  ledger   LedgerEntry[]

  @@unique([organizationId, taxNumber])
  @@index([organizationId])
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  name           String
  address        String?
  hasDelivery    Boolean      @default(false)
  createdAt      DateTime     @default(now())

  users            User[]
  tables           DiningTable[]
  stockLevels      StockLevel[]
  movements        StockMovement[]
  purchases        PurchaseInvoice[]
  orders           Order[]
  ledger           LedgerEntry[]
  counts           StockCount[]
  salesImports     SalesImport[]
  adisyoConnection AdisyoConnection?
  adisyoOrders     AdisyoOrder[]

  @@index([organizationId])
}

enum Role {
  OWNER // Patron: tüm şubeler, tüm raporlar
  MANAGER // Müdür: kendi şubesi (branchId boşsa tümü)
  CASHIER // Kasiyer: yalnızca satış ekranı
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  name           String
  email          String       @unique
  passwordHash   String
  role           Role
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  orders Order[]

  @@index([organizationId])
}

// ---------------------------------------------------------------- Menü & reçete

model Category {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sort           Int          @default(0)
  products       Product[]

  @@index([organizationId])
}

model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id])
  name           String
  /// KDV dahil satış fiyatı (TL)
  price          Decimal      @db.Decimal(12, 2)
  /// KDV oranı (%) — restoran hizmetinde genelde 10
  vatRate        Int          @default(10)
  active         Boolean      @default(true)
  sort           Int          @default(0)
  createdAt      DateTime     @default(now())

  recipe     RecipeLine[]
  orderItems OrderItem[]
  saleLines  SalesImportLine[]
  aliases    ProductAlias[]

  @@index([organizationId])
}

enum BaseUnit {
  GR
  ML
  ADET
}

/// Hammadde / stok kalemi (köfte, ekmek, kola şişesi, peynir…)
model StockItem {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  /// Reçetede ve stokta kullanılan temel birim
  unit               BaseUnit
  /// Alışta kullanılan birim adı (örn. "kg", "koli") ve temel birime çevrim katsayısı
  purchaseUnit       String
  purchaseUnitFactor Decimal      @db.Decimal(14, 4)
  /// Son alış maliyeti — temel birim başına, KDV hariç (şube ortalaması yoksa yedek değer)
  lastCost           Decimal      @default(0) @db.Decimal(14, 6)
  /// Kritik stok seviyesi (temel birim)
  minLevel           Decimal      @default(0) @db.Decimal(14, 4)
  createdAt          DateTime     @default(now())

  recipeLines   RecipeLine[]
  levels        StockLevel[]
  movements     StockMovement[]
  purchaseLines PurchaseLine[]
  itemMappings  SupplierItemMapping[]
  countLines    StockCountLine[]

  @@index([organizationId])
}

/// Bir ürünün reçetesindeki satır: 1 adet ürün için kullanılan miktar
model RecipeLine {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id])
  /// Temel birim cinsinden miktar
  quantity    Decimal   @db.Decimal(14, 4)
  /// Fire oranı (%) — örn. patateste soyma/kızartma kaybı
  wastePct    Decimal   @default(0) @db.Decimal(5, 2)

  @@unique([productId, stockItemId])
}

// ---------------------------------------------------------------- Stok

/// Şube bazında stok miktarı ve ağırlıklı ortalama maliyet
model StockLevel {
  id          String    @id @default(cuid())
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(14, 4)
  /// Temel birim başına ağırlıklı ortalama maliyet, KDV hariç
  avgCost     Decimal   @default(0) @db.Decimal(14, 6)

  @@unique([branchId, stockItemId])
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  WASTE
}

model StockMovement {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  stockItemId    String
  stockItem      StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type           MovementType
  /// Temel birim; giriş pozitif, çıkış negatif
  quantity       Decimal      @db.Decimal(14, 4)
  unitCost       Decimal      @db.Decimal(14, 6)
  refId          String?
  createdAt      DateTime     @default(now())

  @@index([branchId, createdAt])
}

// ---------------------------------------------------------------- Cari hesaplar

enum AccountType {
  SUPPLIER // Tedarikçi
  CUSTOMER // Müşteri (açık hesap / kurumsal)
}

model Account {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           AccountType
  name           String
  taxNumber      String?
  taxOffice      String?
  phone          String?
  email          String?
  address        String?
  createdAt      DateTime     @default(now())

  entries      LedgerEntry[]
  purchases    PurchaseInvoice[]
  orders       Order[]
  itemMappings SupplierItemMapping[]

  @@index([organizationId])
}

enum LedgerSource {
  OPENING
  PURCHASE
  SALE
  PAYMENT
}

/// Cari hareket. Bakiye = SUM(borç) − SUM(alacak).
/// Pozitif bakiye: karşı taraf bize borçlu. Negatif bakiye: biz karşı tarafa borçluyuz.
model LedgerEntry {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// Cari bakiyeler şirket bazında ayrılır (aynı tedarikçinin her şirketle ayrı bakiyesi olur)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id])
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])
  date           DateTime     @default(now())
  description    String
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
  source         LedgerSource
  sourceId       String?

  @@index([accountId, date])
  @@index([companyId, accountId])
}

// ---------------------------------------------------------------- Alışlar

model PurchaseInvoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id])
  supplierId     String
  supplier       Account      @relation(fields: [supplierId], references: [id])
  invoiceNo      String
  date           DateTime
  totalNet       Decimal      @db.Decimal(12, 2)
  totalVat       Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2)
  /// Gelen e-faturadan oluşturulduysa ETTN
  eInvoiceUuid   String?
  createdAt      DateTime     @default(now())

  lines      PurchaseLine[]
  eDocuments EDocument[]

  @@unique([organizationId, eInvoiceUuid])
  @@index([organizationId, date])
}

model PurchaseLine {
  id          String          @id @default(cuid())
  invoiceId   String
  invoice     PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  /// Boşsa stoğa girmeyen kalem (nakliye, ambalaj, hizmet vb. gider)
  stockItemId String?
  stockItem   StockItem?      @relation(fields: [stockItemId], references: [id])
  description String?
  /// Alış birimi cinsinden miktar (örn. 5 kg)
  quantity    Decimal         @db.Decimal(14, 4)
  /// Alış birimi başına KDV hariç fiyat
  unitPrice   Decimal         @db.Decimal(14, 4)
  vatRate     Int
  lineNet     Decimal         @db.Decimal(12, 2)
}

// ---------------------------------------------------------------- Satış (adisyon)

model DiningTable {
  id       String  @id @default(cuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name     String
  area     String  @default("Salon")
  sort     Int     @default(0)
  orders   Order[]

  @@index([branchId])
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderChannel {
  POS
  YEMEKSEPETI
  GETIR
  TRENDYOL
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

model Order {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId          String
  branch            Branch       @relation(fields: [branchId], references: [id])
  tableId           String?
  table             DiningTable? @relation(fields: [tableId], references: [id])
  userId            String?
  user              User?        @relation(fields: [userId], references: [id])
  customerAccountId String?
  customerAccount   Account?     @relation(fields: [customerAccountId], references: [id])
  number            Int
  type              OrderType    @default(DINE_IN)
  channel           OrderChannel @default(POS)
  externalId        String?
  status            OrderStatus  @default(OPEN)
  /// KDV dahil toplam (indirim sonrası)
  total             Decimal      @default(0) @db.Decimal(12, 2)
  discount          Decimal      @default(0) @db.Decimal(12, 2)
  /// Kapanışta hesaplanan toplam maliyet (KDV hariç)
  totalCost         Decimal      @default(0) @db.Decimal(12, 2)
  openedAt          DateTime     @default(now())
  closedAt          DateTime?

  items      OrderItem[]
  payments   Payment[]
  eDocuments EDocument[]

  @@index([branchId, status])
  @@index([organizationId, closedAt])
}

enum ItemStatus {
  ACTIVE
  CANCELLED
}

model OrderItem {
  id        String     @id @default(cuid())
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product    @relation(fields: [productId], references: [id])
  name      String
  quantity  Int
  /// KDV dahil birim fiyat
  unitPrice Decimal    @db.Decimal(12, 2)
  vatRate   Int
  /// Satış anındaki reçete maliyeti (KDV hariç, birim başına) — kapanışta sabitlenir
  unitCost  Decimal    @default(0) @db.Decimal(12, 4)
  status    ItemStatus @default(ACTIVE)
  note      String?
  createdAt DateTime   @default(now())
}

enum PaymentMethod {
  CASH
  CARD
  ACCOUNT // Cariye (açık hesap)
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  createdAt DateTime      @default(now())
}

// ---------------------------------------------------------------- E-belge (e-fatura / e-arşiv)

enum EDocType {
  E_FATURA
  E_ARSIV
}

enum EDocDirection {
  OUTGOING
  INCOMING
}

enum EDocStatus {
  DRAFT // Gelen belge: işlenmeyi bekliyor
  QUEUED
  SENT
  PROCESSED // Gelen belge: alış faturasına dönüştürüldü
  IGNORED // Gelen belge: kullanıcı yok saydı
  ERROR
}

model EDocument {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type              EDocType
  direction         EDocDirection
  status            EDocStatus       @default(DRAFT)
  provider          String
  /// Sağlayıcıdaki belge no / ETTN
  externalId        String?
  documentNo        String?
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id])
  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])
  payload           Json
  error             String?
  createdAt         DateTime         @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, externalId])
}

/// Tedarikçinin faturadaki ürününü bizim stok kalemimizle eşleştirme hafızası.
/// Bir kez eşleştirilen kalem sonraki faturalarda otomatik tanınır.
model SupplierItemMapping {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Account      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  /// Tedarikçinin ürün kodu ya da (kod yoksa) normalize edilmiş ürün adı
  itemKey        String
  /// Boşsa: bu kalem stoğa girmez (gider)
  stockItemId    String?
  stockItem      StockItem?   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  /// Faturadaki 1 birim = kaç temel birim (gr/ml/adet)
  baseQtyPerUnit Decimal      @default(1) @db.Decimal(14, 4)
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, supplierId, itemKey])
}

// ---------------------------------------------------------------- Stok sayımı ve aylık kapanış

/// Şubenin belirli bir andaki fiili stok sayımı (ay sonu / dönem başı)
model StockCount {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  /// Sayımın yapıldığı gün (Türkiye saatiyle gün sonu kabul edilir)
  countedAt      DateTime
  fileName       String?
  note           String?
  createdAt      DateTime         @default(now())
  lines          StockCountLine[]

  @@unique([branchId, countedAt])
  @@index([organizationId, countedAt])
}

model StockCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem  @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  /// Temel birim (gr / ml / adet)
  quantity    Decimal    @db.Decimal(14, 4)
  /// Açılış sayımında girilen birim maliyet (temel birim başına, KDV hariç); boşsa son alış maliyeti kullanılır
  unitCost    Decimal?   @db.Decimal(14, 6)

  @@unique([countId, stockItemId])
}

/// Dış sistemden (Adisyo) yüklenen ürün bazında satış raporu
model SalesImport {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  periodStart    DateTime
  periodEnd      DateTime
  source         String            @default("adisyo")
  fileName       String?
  createdAt      DateTime          @default(now())
  lines          SalesImportLine[]

  @@index([branchId, periodStart])
}

model SalesImportLine {
  id           String      @id @default(cuid())
  importId     String
  import       SalesImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  /// Rapordaki ürün adı
  externalName String
  /// Eşleştiği ürün (eşleşmediyse boş: teorik tüketime katılmaz)
  productId    String?
  product      Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  quantity     Decimal     @db.Decimal(12, 3)
  /// Satış tutarı (KDV dahil)
  revenue      Decimal     @default(0) @db.Decimal(14, 2)
}

/// Dış sistemdeki ürün adı ↔ programdaki ürün eşleştirme hafızası
model ProductAlias {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  alias          String
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, alias])
}

// ---------------------------------------------------------------- Adisyo entegrasyonu

/// Grup düzeyinde Adisyo API bilgileri (entegratör anahtarı ve tüketici adı). Anahtar şifreli saklanır.
model AdisyoAccount {
  id             String       @id @default(cuid())
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeyEnc      String
  consumer       String
  updatedAt      DateTime     @updatedAt
}

/// Şubenin Adisyo restoran bağlantısı (x-api-secret şifreli)
model AdisyoConnection {
  id            String    @id @default(cuid())
  branchId      String    @unique
  branch        Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  apiSecretEnc  String
  secretHint    String
  active        Boolean   @default(true)
  /// İlk eşitlemede bu tarihten itibaren siparişler çekilir
  startFrom     DateTime
  /// Bir sonraki eşitlemenin başlayacağı an (en son alınan siparişin zamanı)
  cursor        DateTime?
  lastSyncAt    DateTime?
  lastStatus    String?
  lastError     String?
  /// Adisyo hız sınırı (CompletedOrders: 40 saniyede 1 istek) için son istek zamanı
  lastRequestAt DateTime?
  /// Yarım kalan eşitleme: sabit başlangıç, sıradaki sayfa ve o ana kadarki en yeni sipariş zamanı
  runStart      DateTime?
  nextPage      Int?
  runMaxDate    DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Adisyo'dan alınan tamamlanmış sipariş
model AdisyoOrder {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  externalId     String
  orderNumber    String?
  orderDate      DateTime
  orderType      String?
  channel        String?
  status         String?
  cancelled      Boolean           @default(false)
  /// KDV dahil sipariş toplamı (indirim sonrası)
  total          Decimal           @db.Decimal(14, 2)
  discount       Decimal           @default(0) @db.Decimal(14, 2)
  payments       Json?
  lines          AdisyoOrderLine[]

  @@unique([branchId, externalId])
  @@index([branchId, orderDate])
}

model AdisyoOrderLine {
  id          String      @id @default(cuid())
  orderId     String
  order       AdisyoOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId  String?
  parentId    String?
  isMenu      Boolean     @default(false)
  productCode String?
  productName String
  quantity    Decimal     @db.Decimal(12, 3)
  unitPrice   Decimal     @default(0) @db.Decimal(14, 2)
  /// KDV dahil satır tutarı (satır indirimi düşülmüş)
  amount      Decimal     @default(0) @db.Decimal(14, 2)
  cancelled   Boolean     @default(false)
  features    Json?

  @@index([orderId])
}
